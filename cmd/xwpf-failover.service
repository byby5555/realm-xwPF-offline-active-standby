[Unit]
Description=xwpf-failover — active/passive TCP failover proxy (xwPF)
Documentation=https://github.com/byby5555/realm-xwPF-offline-active-standby
After=network.target realm.service
Wants=realm.service
# ★ 崩溃循环限流（本次事故的核心防线）：
#   60 秒内最多拉起 3 次，超限后 systemd 停手，不再无限重启。
#   没有这两行时：监听端口被占用 → 进程每 RestartSec 起落一次 →
#   journald 疯狂写盘 + 进程反复起落。
#
# ★ 限流触发后 unit 会停在 failed 状态，systemd 不会自己再拉起，需要人工：
#   systemctl reset-failed xwpf-failover && systemctl start xwpf-failover
#   （先解决端口占用等根因，再 reset-failed，否则立刻又撞限流）
#
# ★ 本文件由 pf install / 更新中心从 cmd/xwpf-failover.service 重装覆盖，
#   直接改 /etc/systemd/system/xwpf-failover.service 会被冲掉；
#   要改本机参数请用 drop-in：systemctl edit xwpf-failover
#
# ★ pf install 还会写一份同内容的 drop-in
#   /etc/systemd/system/xwpf-failover.service.d/10-crash-loop-guard.conf
#   （每次 install / 升级都重写同一路径）—— 两处内容一致，哪边生效结果相同。
StartLimitIntervalSec=60
StartLimitBurst=3
# 显式写死：默认值可被系统级 DefaultStartLimitAction 覆盖，
# 继承到 reboot / poweroff 之类就危险了。
StartLimitAction=none

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /usr/local/bin/xwpf-failover -c /etc/xwpf/failover.json
# ★ 保持 always，不要改成 on-failure：
#   守护「异常退出」现在一律返回非 0（见 cmd/xwpf-failover.py 的退出码语义），
#   但 always 还有一道纵深 —— 就算将来有人改坏了退出码语义，
#   always 也会把它拉起来（响亮地失败），而 on-failure 会让它静默消失、
#   转发悄悄断掉。故障转移守护宁可吵，不可静默。
#   另外：被 systemd 之外的信号杀掉时（例如运维手工 kill），
#   always 会自愈，on-failure 不会。
Restart=always
RestartSec=5s
# Run as root to bind privileged ports (e.g. 443).
WorkingDirectory=/etc/xwpf
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xwpf-failover

# Hardening: config dir is writable **for one reason only** — the daemon
# persists its runtime state there (failover-state.json: current primary,
# probe target, forward target, consecutive failure counts, last switch time).
# Everything else on the box stays read-only (ProtectSystem=strict).
ReadWritePaths=/etc/xwpf
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
